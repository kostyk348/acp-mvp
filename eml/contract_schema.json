{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "agent-contract/v1",
  "title": "ACPContract",
  "type": "object",
  "required": ["schema", "schema_version", "intent", "verification", "settlement"],
  "properties": {
    "schema": {
      "type": "string",
      "const": "agent-contract/v1"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "intent": {
      "type": "object",
      "required": ["type", "domain"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ci.compile", "ci.test", "eda.pcb.layout", "render.3d", "inference.ml"]
        },
        "domain": { "type": "string" },
        "language": { "type": "string" },
        "source": {
          "oneOf": [
            {
              "type": "object",
              "required": ["type", "data"],
              "properties": {
                "type": { "const": "base64" },
                "data": { "type": "string" }
              }
            },
            {
              "type": "object",
              "required": ["type", "cid"],
              "properties": {
                "type": { "const": "ipfs" },
                "cid": { "type": "string" }
              }
            },
            {
              "type": "object",
              "required": ["type", "url"],
              "properties": {
                "type": { "const": "git" },
                "url": { "type": "string" },
                "commit": { "type": "string" }
              }
            }
          ]
        },
        "requirements": { "type": "object" }
      }
    },
    "verification": {
      "type": "object",
      "required": ["tests"],
      "properties": {
        "tests": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["cmd"],
            "properties": {
              "cmd": { "type": "string" },
              "timeout": { "type": "integer", "minimum": 1 },
              "expected_exit_code": { "type": "integer", "default": 0 }
            }
          }
        },
        "artifacts_expected": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": { "type": "string" },
              "min_size": { "type": "integer" },
              "checksum": { "type": "string" }
            }
          }
        }
      }
    },
    "settlement": {
      "type": "object",
      "required": ["on_success", "on_failure"],
      "properties": {
        "on_success": {
          "type": "string",
          "enum": ["release_escrow", "partial_release"]
        },
        "on_failure": {
          "type": "string",
          "enum": ["refund", "slash_stake"]
        },
        "royalty_split": {
          "type": "object",
          "properties": {
            "human_principal": { "type": "integer", "minimum": 0, "maximum": 100 },
            "agent_executor": { "type": "integer", "minimum": 0, "maximum": 100 }
          }
        },
        "auto_verify": { "type": "boolean" }
      }
    },
    "sint_ua": {
      "type": "object",
      "properties": {
        "project_tag": { "type": "string" },
        "required_confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  },
  "additionalProperties": false
}
