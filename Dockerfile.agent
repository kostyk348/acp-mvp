FROM python:3.12-slim

LABEL maintainer="acp-mvp"
LABEL description="ACP Agent Node"

# System deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    docker.io \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Rust toolchain (for Rust compile contracts)
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y \
    && . "$HOME/.cargo/env" \
    && rustup target add wasm32-unknown-unknown

# Python deps
COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

# Create agent user
RUN useradd -m -s /bin/bash agent && \
    mkdir -p /home/agent/.agent && \
    chown -R agent:agent /home/agent

WORKDIR /home/agent/app
COPY --chown=agent:agent . .

USER agent

EXPOSE 2525

ENV PYTHONPATH=/home/agent/app
ENV ACP_AGENT_PASSWORD=change-me

ENTRYPOINT ["python", "-m", "orchestrator"]
